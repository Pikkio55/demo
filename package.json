{
  "name": "telnyx-outbound-campaigns",
  "version": "1.0.0",
  "description": "Webapp per campagne outbound con assistenti AI Telnyx",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "body-parser": "^1.20.2",
    "axios": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "csv-parse": "^5.5.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}
